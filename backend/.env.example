############################################
# APPLICATION CONFIGURATION
############################################
NODE_ENV=development
PORT=4001
API_PREFIX=api/v1

############################################
# CORS & FRONTEND ORIGINS
############################################
CORS_ORIGINS=http://localhost:3000,http://localhost:5173,http://localhost:3006,https://ecomwebzio.vercel.app

############################################
# DATABASE (Prisma PostgreSQL)
############################################
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/ecommerce?schema=public

############################################
# JWT AUTHENTICATION
############################################
JWT_ACCESS_SECRET=your_access_secret_change_me_in_production
JWT_REFRESH_SECRET=your_refresh_secret_change_me_in_production
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_EXPIRES=30d

############################################
# SECURITY & HASHING
############################################
BCRYPT_SALT_ROUNDS=12

############################################
# EMAIL (SMTP)
############################################
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=support@example.com
SMTP_PASS=your_smtp_app_password
EMAIL_FROM="Ecom Support <support@example.com>"

############################################
# CLOUDINARY MEDIA STORAGE
############################################
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

############################################
# WHATSAPP INTEGRATION
############################################
WHATSAPP_PHONE=+1234567890

############################################
# FILE UPLOADS & LOGGING
############################################
MAX_FILE_SIZE=10485760
ALLOWED_IMAGE_TYPES=jpg,jpeg,png,webp,avif
LOG_LEVEL=debug
