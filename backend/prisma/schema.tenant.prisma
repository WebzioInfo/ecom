generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}



enum DiscountType {
  PERCENTAGE
  FIXED_AMOUNT
  FREE_SHIPPING
}

enum NotificationType {
  INFO
  WARNING
  SUCCESS
  ERROR
}

enum OrderStatus {
  PENDING
  PAID
  SHIPPED
  DELIVERED
  CANCELLED
}


model AuditLog {
  id          String   @id @default(uuid())
  storeId     String?  // Keep storeId column for backward compatibility (logical reference)
  userId      String   // Logical reference to User in public schema
  action      String
  entity      String
  entityId    String?
  changes     Json
  ipAddress   String?
  userAgent   String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Cart {
  id        String   @id @default(uuid())
  userId    String   @unique // Logical reference to User in public schema
  items     Json     @default("[]") 
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Category {
  id          String     @id @default(uuid())
  name        String     @unique
  slug        String     @unique
  description String?
  banner      String?
  parentId    String?
  parent      Category?  @relation("CategoryToCategory", fields: [parentId], references: [id], onDelete: Cascade)
  children    Category[] @relation("CategoryToCategory")
  image       String?
  sortOrder   Int        @default(0)
  isActive    Boolean    @default(true)
  isDeleted   Boolean    @default(false)
  deletedAt   DateTime?
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
}

model Customer {
  id          String   @id @default(uuid())
  storeId     String   // Keep storeId column (logical reference)
  firstName   String
  lastName    String
  email       String
  phone       String?
  addresses   Json     @default("[]") 
  tags        String[] @default([])
  totalOrders Int      @default(0)
  totalSpent  Float    @default(0)
  notes       String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([storeId, email])
}

model Warehouse {
  id        String   @id @default(uuid())
  storeId   String   // Keep storeId column (logical reference)
  name      String
  code      String   @unique
  address   String?
  city      String?
  country   String?
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([storeId, code])
}

model StockMovement {
  id          String   @id @default(uuid())
  productId   String
  warehouseId String?
  type        String   // IN, OUT, ADJUSTMENT
  quantity    Int
  reason      String?
  createdBy   String?
  createdAt   DateTime @default(now())
}

model Coupon {
  id             String       @id @default(uuid())
  storeId        String       // Keep storeId column (logical reference)
  code           String
  type           DiscountType @default(PERCENTAGE)
  value          Float
  minOrderAmount Float        @default(0)
  maxUses        Int          @default(0)
  usedCount      Int          @default(0)
  startsAt       DateTime?
  expiresAt      DateTime?
  isActive       Boolean      @default(true)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@unique([storeId, code])
}

model PlatformNotification {
  id        String           @id @default(uuid())
  title     String
  message   String
  type      NotificationType @default(INFO)
  storeId   String?          // Keep storeId column (logical reference)
  isRead    Boolean          @default(false)
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt
}

model Order {
  id              String      @id @default(uuid())
  orderNumber     String?     @unique
  userId          String      // Logical reference to User in public schema
  customerInfo    Json?       // Quick snapshot of customer { name, email, phone }
  items           Json
  totalAmount     Float
  taxAmount       Float       @default(0)
  discountAmount  Float       @default(0)
  status          OrderStatus @default(PENDING)
  paymentStatus   String      @default("UNPAID")
  deliveryStatus  String      @default("UNFULFILLED")
  courier         String?
  trackingNumber  String?
  shippingAddress Json?
  billingAddress  Json?
  timeline        Json        @default("[]")
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt
}

model Product {
  id               String    @id @default(uuid())
  title            String
  sku              String?
  barcode          String?
  shortDescription String?
  description      String
  price            Float
  offerPrice       Float?
  costPrice        Float?
  stock            Int
  minStock         Int       @default(5)
  weight           Float?
  dimensions       Json?
  gst              Float?
  tax              Float?
  category         String
  brand            String
  images           String[]
  rating           Float     @default(0)
  discount         Float     @default(0)
  status           String    @default("PUBLISHED") // DRAFT, PUBLISHED, ARCHIVED
  featured         Boolean   @default(false)
  isActive         Boolean   @default(true)
  isDeleted        Boolean   @default(false)
  deletedAt        DateTime?
  seoTitle         String?
  seoDescription   String?
  tags             String[]  @default([])
  attributes       Json?     @default("[]")
  variants         Json?     @default("[]")
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
}
